{
  "name": "wheelhouse-rebuild",
  "version": "1.0.0",
  "private": true,
  "description": "A rebuilt one-page website for Wheelhouse Bike Repair, Kwame's bike repair workshop in Adum, Kumasi. It's built mobile-first in plain HTML, CSS and a little JavaScript, and checked against WCAG 2.2 level AA.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qcalvin3/wheelhouse-rebuild.git"
  },
  "bugs": {
    "url": "https://github.com/qcalvin3/wheelhouse-rebuild/issues"
  },
  "homepage": "https://github.com/qcalvin3/wheelhouse-rebuild#readme",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "vite": "8.4.0"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,md,json,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
